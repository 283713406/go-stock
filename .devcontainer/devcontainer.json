{
  "name": "go-stock",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspaces/go-stock",
  "remoteUser": "root",
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
    "XDG_RUNTIME_DIR": "/tmp/vscode-runtime",
    "GOPATH": "/go",
    "GOBIN": "/go/bin"
  },
  "runArgs": [
    "--init",
    "--cap-add=SYS_PTRACE",
    "--security-opt",
    "seccomp=unconfined"
  ],
  "mounts": [
    "source=go-stock-gomod,target=/go/pkg/mod,type=volume",
    "source=go-stock-gocache,target=/root/.cache/go-build,type=volume",
    "source=go-stock-npm-cache,target=/root/.npm,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "mkdir -p /tmp/vscode-runtime && chmod 700 /tmp/vscode-runtime",
  "forwardPorts": [
    5173,
    5174,
    34115,
    18081
  ],
  "portsAttributes": {
    "5173": {
      "label": "Wails/Vite frontend"
    },
    "5174": {
      "label": "AI assistant web frontend"
    },
    "34115": {
      "label": "Wails dev server"
    },
    "18081": {
      "label": "AI assistant web"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.Go",
        "Vue.volar",
        "dbaeumer.vscode-eslint",
        "EditorConfig.EditorConfig",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "go.toolsManagement.checkForUpdates": "local",
        "go.useLanguageServer": true,
        "go.gopath": "/go",
        "go.goroot": "/usr/local/go",
        "go.lintTool": "golangci-lint",
        "typescript.tsdk": "frontend/node_modules/typescript/lib",
        "vue.server.hybridMode": true,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
